<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Bfocus.Monitor.AspNetCore</AssemblyName>
    <RootNamespace>Bfocus.Monitor</RootNamespace>

    <!-- Mesma versão do Bfocus.Monitor (um teste trava). -->
    <PackageId>Bfocus.Monitor.AspNetCore</PackageId>
    <Version>0.1.1</Version>
    <Authors>Berni Software</Authors>
    <Company>Berni Software</Company>
    <Product>bFocus</Product>
    <Copyright>Copyright (c) Berni Software</Copyright>
    <Description>Integração ASP.NET Core do monitoramento de erros do bFocus: app.UseBfocusMonitor() captura o erro da requisição (com método, rota e identidade da própria requisição) e relança.</Description>
    <PackageTags>bfocus;monitor;errors;error-tracking;aspnetcore;middleware;berni</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/bernisoftware/bfocus-monitor-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bernisoftware/bfocus-monitor-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- O framework compartilhado que todo app ASP.NET Core já tem: nenhum pacote a mais. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Bfocus.Monitor/Bfocus.Monitor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
